{
  "name": "@avfs/avfs-cli",
  "version": "0.1.0",
  "description": "AVFS CLI — universal cross-storage addressing tool",
  "type": "module",
  "bin": {
    "avfs": "./dist/index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "avfs",
    "virtual-filesystem",
    "cross-storage",
    "cli"
  ],
  "license": "Apache-2.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avfs/avfs-core.git",
    "directory": "cli"
  }
}
