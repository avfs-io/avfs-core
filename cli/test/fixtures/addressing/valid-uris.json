{
  "meta": {
    "description": "5 协议合法 AVFS URI 测试用例 — 用于验证 parseAvfsUri() 正确解析所有协议",
    "version": "1.0.0",
    "protocols": ["file", "http", "https", "smb", "git"]
  },
  "testCases": [
    {
      "id": "file-01",
      "description": "Unix 绝对路径 (file 协议)",
      "input": "avfs://file/home/user/config.json",
      "expected": {
        "protocol": "file",
        "resourceBase": "home",
        "version": null,
        "filePath": "user/config.json",
        "anchor": null,
        "isValid": true
      },
      "tags": ["file", "unix-path"]
    },
    {
      "id": "file-02",
      "description": "相对路径 (file 协议)",
      "input": "avfs://file/./local/data.csv",
      "expected": {
        "protocol": "file",
        "resourceBase": ".",
        "version": null,
        "filePath": "local/data.csv",
        "anchor": null,
        "isValid": true
      },
      "tags": ["file", "relative-path"]
    },
    {
      "id": "file-03",
      "description": "file 协议带 anchor",
      "input": "avfs://file/home/user/app.log#L120",
      "expected": {
        "protocol": "file",
        "resourceBase": "home",
        "version": null,
        "filePath": "user/app.log",
        "anchor": "L120",
        "isValid": true
      },
      "tags": ["file", "anchor"]
    },
    {
      "id": "http-01",
      "description": "HTTP 协议带 IP 和端口",
      "input": "avfs://http/192.168.1.100:8080/api/data.csv",
      "expected": {
        "protocol": "http",
        "resourceBase": "192.168.1.100:8080",
        "version": null,
        "filePath": "api/data.csv",
        "anchor": null,
        "isValid": true
      },
      "tags": ["http", "ip-port"]
    },
    {
      "id": "http-02",
      "description": "HTTP 协议域名无端口",
      "input": "avfs://http/example.com/assets/style.css",
      "expected": {
        "protocol": "http",
        "resourceBase": "example.com",
        "version": null,
        "filePath": "assets/style.css",
        "anchor": null,
        "isValid": true
      },
      "tags": ["http", "domain"]
    },
    {
      "id": "https-01",
      "description": "HTTPS CDN 地址",
      "input": "avfs://https/cdn.example.com/files/v1/package.zip",
      "expected": {
        "protocol": "https",
        "resourceBase": "cdn.example.com",
        "version": null,
        "filePath": "files/v1/package.zip",
        "anchor": null,
        "isValid": true
      },
      "tags": ["https", "cdn"]
    },
    {
      "id": "https-02",
      "description": "HTTPS 带端口",
      "input": "avfs://https/api.example.com:8443/v2/users.json",
      "expected": {
        "protocol": "https",
        "resourceBase": "api.example.com:8443",
        "version": null,
        "filePath": "v2/users.json",
        "anchor": null,
        "isValid": true
      },
      "tags": ["https", "port"]
    },
    {
      "id": "smb-01",
      "description": "SMB 局域网共享文件",
      "input": "avfs://smb/192.168.1.60/share/docs/report.xlsx",
      "expected": {
        "protocol": "smb",
        "resourceBase": "192.168.1.60",
        "version": null,
        "filePath": "share/docs/report.xlsx",
        "anchor": null,
        "isValid": true
      },
      "tags": ["smb", "lan"]
    },
    {
      "id": "smb-02",
      "description": "SMB 服务器名共享文件",
      "input": "avfs://smb/fileserver/backup/database.sql",
      "expected": {
        "protocol": "smb",
        "resourceBase": "fileserver",
        "version": null,
        "filePath": "backup/database.sql",
        "anchor": null,
        "isValid": true
      },
      "tags": ["smb", "hostname"]
    },
    {
      "id": "git-01",
      "description": "Git 协议带 version 和文件路径",
      "input": "avfs://git/github.com/avfs-io/core@main/readme.md",
      "expected": {
        "protocol": "git",
        "resourceBase": "github.com/avfs-io/core",
        "version": "main",
        "filePath": "readme.md",
        "anchor": null,
        "isValid": true
      },
      "tags": ["git", "version", "github"]
    },
    {
      "id": "git-02",
      "description": "Git 协议带 version 和深层文件路径",
      "input": "avfs://git/github.com/avfs-io/core@v1.0.0/script/build.sh",
      "expected": {
        "protocol": "git",
        "resourceBase": "github.com/avfs-io/core",
        "version": "v1.0.0",
        "filePath": "script/build.sh",
        "anchor": null,
        "isValid": true
      },
      "tags": ["git", "version", "tag", "deep-path"]
    },
    {
      "id": "git-03",
      "description": "Git 协议带 anchor",
      "input": "avfs://git/github.com/avfs-io/core@main/src/index.ts#L42",
      "expected": {
        "protocol": "git",
        "resourceBase": "github.com/avfs-io/core",
        "version": "main",
        "filePath": "src/index.ts",
        "anchor": "L42",
        "isValid": true
      },
      "tags": ["git", "version", "anchor"]
    }
  ]
}
