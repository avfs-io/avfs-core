{
  "meta": {
    "description": "非法 AVFS URI 测试用例 — 覆盖常见错误格式，验证解析器正确返回错误信息",
    "version": "1.0.0"
  },
  "testCases": [
    {
      "id": "invalid-01",
      "description": "缺少 avfs:// 前缀",
      "input": "not-an-avfs-address",
      "expected": {
        "isValid": false,
        "hasError": "Address must start with 'avfs://'"
      },
      "tags": ["prefix", "schema"]
    },
    {
      "id": "invalid-02",
      "description": "仅有 avfs:// 前缀无内容",
      "input": "avfs://",
      "expected": {
        "isValid": false,
        "hasError": "Address is empty after prefix"
      },
      "tags": ["prefix", "empty"]
    },
    {
      "id": "invalid-03",
      "description": "不支持的协议类型",
      "input": "avfs://ftp/host/path/file.txt",
      "expected": {
        "isValid": false,
        "hasError": "Unsupported protocol"
      },
      "tags": ["protocol", "unsupported"]
    },
    {
      "id": "invalid-04",
      "description": "缺少 resourceBase 和 filePath（无斜杠）",
      "input": "avfs://file",
      "expected": {
        "isValid": false,
        "hasError": "File path is required"
      },
      "tags": ["structure", "missing-path"]
    },
    {
      "id": "invalid-05",
      "description": "Git 协议仅有 version 无 filePath",
      "input": "avfs://git/github.com/avfs-io/core@main",
      "expected": {
        "isValid": false,
        "hasError": "File path is required when version is specified"
      },
      "tags": ["git", "missing-path", "version-only"]
    },
    {
      "id": "invalid-06",
      "description": "Git 协议无 resourceBase 和 filePath",
      "input": "avfs://git",
      "expected": {
        "isValid": false,
        "hasError": "File path is required"
      },
      "tags": ["git", "bare-protocol"]
    },
    {
      "id": "invalid-07",
      "description": "空字符串输入",
      "input": "",
      "expected": {
        "isValid": false,
        "hasError": "Address must start with 'avfs://'"
      },
      "tags": ["boundary", "empty-string"]
    },
    {
      "id": "invalid-08",
      "description": "仅 avfs:// 前缀（无协议斜杠后内容）",
      "input": "avfs://file/",
      "expected": {
        "isValid": false,
        "hasError": "Missing resource base"
      },
      "tags": ["boundary", "no-resource-base"]
    },
    {
      "id": "invalid-09",
      "description": "协议名包含非法字符（大写）",
      "input": "avfs://FILE/home/user/test.txt",
      "expected": {
        "isValid": false,
        "hasError": "Unsupported protocol"
      },
      "tags": ["protocol", "case-sensitive"]
    },
    {
      "id": "invalid-10",
      "description": "协议名包含特殊字符",
      "input": "avfs://git_hub/host/path",
      "expected": {
        "isValid": false,
        "hasError": "Unsupported protocol"
      },
      "tags": ["protocol", "special-char"]
    }
  ]
}
